{
  "name": "bmi-stooring-system",
  "version": "0.0.0",
  "private": true,
  "description": "BMI Stooring System — monorepo (NestJS API, Next.js web, Expo mobile, shared packages).",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "eslint apps packages --no-error-on-unmatched-pattern && turbo run lint",
    "lint:fix": "eslint apps packages --no-error-on-unmatched-pattern --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
